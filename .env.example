# Copy this file to .env and replace every placeholder. Never commit .env.
# Each variable says which process reads it: the server (apps/server),
# the MCP server (apps/mcp), or Docker Compose (docker-compose.yml).

# --- Required by the server -------------------------------------------------

# Bot token from @BotFather, in the form 123456789:AA...
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token

# Comma-separated numeric Telegram user ids allowed to use the bot.
# Anyone else gets "Sorry, this bot is private."
TELEGRAM_ALLOWED_USER_IDS=123456789

# Public URL of the app, without a trailing slash. Login links are built from it.
# Local polling with the Vite dev server: http://localhost:5173
# Docker or production: your https URL, for example https://notes.example.com
BASE_URL=http://localhost:5173

# --- Optional for the server ------------------------------------------------

# HTTP port the server listens on. Default: 3000.
# PORT=3000

# Postgres connection string. When unset, the server uses PGlite (embedded
# Postgres) in PGLITE_DATA_DIR. Docker Compose sets this for the app itself.
# DATABASE_URL=postgres://notes:replace-with-password@localhost:5432/notes

# Directory for the PGlite database, used when DATABASE_URL is unset.
# Default: .data/pglite (relative to the directory the server runs from).
# PGLITE_DATA_DIR=.data/pglite

# Folder of the built web app (apps/web/dist). When set, the server also serves
# the web app. Relative paths are relative to the directory the server runs from,
# which is the repository root for the commands in the README. Leave it unset for
# local dev, where the Vite dev server serves the web app.
# WEB_ROOT=apps/web/dist

# Secret that Telegram sends back with every webhook call. Setting it switches
# the bot from polling to webhook mode, which requires an https BASE_URL.
# Use a long random string. Leave it unset for polling.
# TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-string

# --- Optional for the MCP server (apps/mcp) ---------------------------------

# Token from the /mcptoken command in the bot. Shown once, so copy it then.
# Read by the MCP server only.
# MCP_API_TOKEN=replace-with-token-from-mcptoken

# The MCP server reads DATABASE_URL or PGLITE_DATA_DIR too, but unlike the server
# it has no PGlite default: set PGLITE_DATA_DIR to an absolute path, or set
# DATABASE_URL, or the MCP server exits at startup.

# --- Docker Compose only ----------------------------------------------------

# Password for the postgres service. Used by docker-compose.yml, which builds
# DATABASE_URL for the app from it. Use letters and digits only, so the
# connection string needs no escaping.
# POSTGRES_PASSWORD=replace-with-database-password
